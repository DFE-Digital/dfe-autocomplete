{
  "name": "dfe-autocomplete",
  "version": "1.0.0",
  "description": "DfE Autocomplete built on top of accessible autocomplete lib",
  "main": "dist/dfe-autocomplete.min.js",
  "style": "dist/dfe-autocomplete.min.css",
  "sass": "src/dfe-autocomplete.scss",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run test/unit/",
    "test:integration": "vitest run test/integration/",
    "test:security": "vitest run test/security/",
    "test:contracts": "vitest run test/contracts/",
    "test:watch": "vitest",
    "compile:js": "cross-env NODE_ENV=production webpack --progress --stats-modules",
    "compile": "npm run -s 'compile:js'",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "lint:exports": "eslint --no-eslintrc --config eslint-exports.config.cjs src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DFE-Digital/dfe-autocomplete.git"
  },
  "author": "DfE-Digital",
  "license": "MIT",
  "keywords": [
    "a11y",
    "accessibility",
    "autocomplete",
    "component",
    "plugin",
    "typeahead",
    "widget"
  ],
  "peerDependencies": {
    "@hotwired/stimulus": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@hotwired/stimulus": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.0",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/plugin-transform-member-expression-literals": "^7.25.9",
    "@babel/plugin-transform-modules-commonjs": "^7.25.9",
    "@babel/plugin-transform-property-literals": "^7.25.9",
    "@babel/plugin-transform-react-jsx": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/register": "^7.25.9",
    "@hotwired/stimulus": "^3.2.2",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "core-js": "^3.39.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "jsdom": "^24.1.3",
    "sass": "^1.81.0",
    "sass-loader": "^16.0.3",
    "source-map-loader": "^5.0.0",
    "standard": "^17.1.2",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "vitest": "^2.1.9",
    "webpack": "^5.71.0",
    "webpack-cli": "^5.1.4"
  },
  "bugs": {
    "url": "https://github.com/DFE-Digital/dfe-autocomplete/issues"
  },
  "homepage": "https://github.com/DFE-Digital/dfe-autocomplete#readme",
  "standard": {
    "parser": "@babel/eslint-parser",
    "ignore": [
      "dist/",
      "coverage/",
      "lib/",
      "spec/dummy/"
    ]
  },
  "dependencies": {
    "accessible-autocomplete": "^3.0.1",
    "govuk-frontend": "^5.8.0"
  }
}
